class Solution:
    def nextGreaterElements(self, nums: List[int]) -> List[int]:
        n=len(nums)
        stack=[]
        ans=[-1]*n
        for i in range(2*n):
            curr=i%n
            while(stack and nums[stack[-1]]<nums[curr]):
                ans[stack.pop()]=nums[curr]
            if i<n:
                stack.append(curr)
        return ans
