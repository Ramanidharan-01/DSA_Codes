# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution:
    def oddEvenList(self, head: Optional[ListNode]) -> Optional[ListNode]:
        if not head:
            return None
        Odd=ListNode(-1)
        Even=ListNode(-1)
        temp=head
        odd_temp=Odd
        even_temp=Even
        switch=True
        while(temp):
            if switch:
                odd_temp.next=temp
                odd_temp=odd_temp.next
            else:
                even_temp.next=temp
                even_temp=even_temp.next
            temp=temp.next
            switch=not switch
        even_temp.next = None
        odd_temp.next=Even.next
        return Odd.next
            
