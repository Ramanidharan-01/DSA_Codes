class Solution:
    def dailyTemperatures(self, temperatures: List[int]) -> List[int]:
        s=[]
        ans = [0] * len(temperatures)
        for temp in range(len(temperatures)):
            while s and temperatures[s[-1]]<temperatures[temp]:
               prev=s.pop()
               ans[prev]=temp-prev
            s.append(temp)
        return ans
