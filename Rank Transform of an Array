class Solution:
    def arrayRankTransform(self, arr: List[int]) -> List[int]:
        d = dict()
        count = 0
        prev = -float('inf')
        for i in sorted(arr):
            if i > prev:
                count += 1
            prev = i
            d[i] = count
        for i in range(len(arr)):
            arr[i] = d[arr[i]]
        return arr
