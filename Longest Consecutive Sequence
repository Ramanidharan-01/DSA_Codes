class Solution:
    def longestConsecutive(self, nums: list[int]) -> int:
        n=len(nums)
        if n==0 or n==1:
            return n
        nums.sort()
        ans=0
        left=0
        for right in range(n-1):
            if nums[right]==nums[right+1]:
                left+=1
                continue
            if nums[right]+1!=nums[right+1]:
                ans=max(ans,right-left+1)
                left=right+1
        ans=max(ans,n-left)
        return ans
