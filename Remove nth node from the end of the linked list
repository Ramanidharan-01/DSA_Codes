# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution:
    def removeNthFromEnd(self, head: Optional[ListNode], n: int) -> Optional[ListNode]:
        l=0
        temp=head
        while(temp):
            l+=1
            temp=temp.next
        if l==n:
            return head.next
        i=0
        curr=head
        next_=head.next
        while(next_):
            i+=1
            if (l-i)==n:
                curr.next=next_.next
            curr=curr.next
            next_=next_.next
        return head
