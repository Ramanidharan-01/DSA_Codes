class Solution:
    def countBits(self, n: int) -> list[int]:
        # Initialize an array of size n + 1 with zeros
        dp = [0] * (n + 1)
        
        for i in range(1, n + 1):
            # dp[i >> 1] shifts right (divides by 2)
            # (i & 1) checks if the least significant bit is 1 (odd number)
            dp[i] = dp[i >> 1] + (i & 1)
            
        return dp
