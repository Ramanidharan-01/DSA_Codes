class Solution:
    def reverse_array(self,i,j,arr):
        while(i<j):
            arr[i],arr[j]=arr[j],arr[i]
            i+=1
            j-=1
    def reverseWords(self, s: str) -> str:
        s=list(s)
        i=0
        j=0
        while(j<len(s)):
            if s[j]==" ":
                self.reverse_array(i,j-1,s)
                j+=1
                i=j
            j+=1
        self.reverse_array(i,len(s)-1,s)
        return "".join(s)
                

