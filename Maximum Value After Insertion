class Solution:
    def maxValue(self, n: str, x: int) -> str:
        sign=True if n[0]=="-" else False
        x_=str(x)
        if not sign:
            for i in range(len(n)):
                if int(n[i])<x:
                    return n[:i]+x_+n[i:]
            return n+x_
        else:
            for i in range(1,len(n)):
                if int(n[i])>x:
                    return n[:i]+x_+n[i:]
            return n+x_
