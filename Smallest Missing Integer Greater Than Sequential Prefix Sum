class Solution:
    def missingInteger(self, nums: list[int]) -> int:
        # Step 1: Calculate the sequential prefix sum
        prefix_sum = nums[0]
        
        for i in range(1, len(nums)):
            if nums[i] == nums[i - 1] + 1:
                prefix_sum += nums[i]
            else:
                break
                
        # Step 2: Check for the smallest missing integer
        nums_set = set(nums)
        
        while prefix_sum in nums_set:
            prefix_sum += 1
            
        return prefix_sum
