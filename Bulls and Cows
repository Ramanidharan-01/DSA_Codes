class Solution:
    def getHint(self, secret: str, guess: str) -> str:
        bulls=0
        cows=0
        secret_d=[0]*10
        guess_d=[0]*10
        for i in range(len(secret)):
            if secret[i]==guess[i]:
                bulls+=1
            else:
                secret_d[int(secret[i])]+=1
                guess_d[int(guess[i])]+=1
        for i in range(10):
            cows+=min(guess_d[i],secret_d[i])
        return str(bulls)+"A"+str(cows)+"B"
