class Solution:
    def countAndSay(self, n: int) -> str:
        ans="1"
        for i in range(n-1):
            l=[]
            char_=ans[0]
            count=0
            for j in ans:
                if j==char_:
                    count+=1
                else:
                    l.append(str(count) + char_)
                    char_=j
                    count=1
            l.append(str(count) + char_)
            ans = "".join(l)
        return ans

